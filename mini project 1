# MAIN PROGRAM
# ==========================================

print("======================================")
print("     STUDENT MARKS & GRADE ANALYZER")
print("======================================")

# Number of subjects
num_subjects = get_positive_integer(
    "Enter number of subjects: "
)

subjects = []

# Accept subject names
for i in range(num_subjects):

    while True:
        subject = input(
            f"Enter name of subject {i+1}: "
        ).strip()

        if not subject:
            print("Subject name cannot be empty.")

        elif subject.lower() in [s.lower() for s in subjects]:
            print("Subject already exists. Enter another name.")

        else:
            subjects.append(subject)
            break


# Number of students
num_students = get_positive_integer(
    "\nEnter number of students: "
)

students = []

# Accept student details
for i in range(num_students):

    print(f"\nEnter details of Student {i+1}")

    while True:
        name = input("Enter student name: ").strip()

        if name:
            break

        print("Name cannot be empty.")

    marks = {}

    # Accept subject-wise marks
    for subject in subjects:
        marks[subject] = get_marks(subject)

    student = {
        "name": name,
        "marks": marks
    }

    # Calculate result
    calculate_result(student, subjects)

    students.append(student)


# Display all student results
display_results(students)

# Display rankings
display_rankings(students)

# Display subject averages
calculate_subject_averages(students, subjects)

print("\n======================================")
print("       ANALYSIS COMPLETED")
print("======================================")
